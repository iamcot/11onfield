# Database Configuration
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration
JWT_ISSUER_URI=http://localhost:8080
JWT_JWK_SET_URI=http://localhost:8080/.well-known/jwks.json

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Email Configuration (for notification system)
# In local dev (MAIL_ENABLED=false), emails are logged to console
# In production, set MAIL_ENABLED=true and configure SMTP settings
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@11of.com
